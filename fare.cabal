cabal-version: 3.0
name: fare
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
synopsis: Restricted file, repository, build, and wire-index tools
description:
  A small independent command surface for bounded file reads, repository
  state, build and documentation gates, and decayed-area queries over
  kimi wire stores. Fare has no free-agent dependency.

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

extra-doc-files:
  readme.md

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  if impl(ghc >=9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Fare.Cli
    Fare.Config
    Fare.Exec
    Fare.Gate
    Fare.Index
    Fare.Read
    Fare.State

  build-depends:
    aeson >=2.2 && <3,
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    optparse-applicative >=0.17 && <0.20,
    process >=1.6 && <1.7,
    text >=1.2 && <3,
    time >=1.9 && <1.15,
    unix >=2.8 && <2.9,

executable fare-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: axioma.hs
  other-modules:
    Axioma.Common
    Axioma.Fare

  build-depends:
    base >=4.20 && <5,
    fare,
    optparse-applicative >=0.17 && <0.20,
    text >=1.2 && <3,

executable fare
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: fare.hs
  other-modules: Paths_fare
  autogen-modules: Paths_fare
  build-depends:
    base >=4.20 && <5,
    fare,
    optparse-applicative >=0.17 && <0.20,
